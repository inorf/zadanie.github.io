  left: 0;
  right: 0;
  height: var(--pixel-topbar-height);
  background: linear-gradient(180deg, rgba(18, 14, 9, 0.98), rgba(54, 42, 30, 0.98));
  border-bottom: 4px solid var(--pixel-border);
  box-shadow: 0 6px 0 var(--pixel-shadow);
  z-index: 1000;
}

.pixel-topbar__inner {
  max-width: 1400px;
  margin: 0 auto;
  padding: 0 1.5rem;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 2rem;
}

.pixel-logo {
  font-size: 1.8rem;
  font-weight: bold;
  letter-spacing: 2px;
  text-decoration: none;
  color: var(--pixel-primary);
  text-shadow: 2px 2px 0 var(--pixel-border);
  position: relative;
  &__sub {
    font-size: 0.7rem;
    color: var(--pixel-secondary);
    text-shadow: none;
    position: absolute;
    bottom: -0.5rem;
    right: 0;
  }
}

.pixel-nav {
  display: flex;
  gap: 1.5rem;
  a {
    color: var(--pixel-text);
    text-decoration: none;
    font-weight: bold;
    font-size: 1rem;
    transition: all 0.05s linear;
    &:hover {
      color: var(--pixel-primary);
      text-shadow: 0 0 2px var(--pixel-primary);
    }
  }
}

.pixel-actions {
  display: flex;
  align-items: center;
}

.pixel-btn {
  background: linear-gradient(180deg, rgba(96, 68, 38, 0.96), rgba(55, 38, 19, 0.98));
  border: 3px solid var(--pixel-gold);
  padding: 0.55rem 1.15rem;
  font-family: inherit;
  font-weight: bold;
  font-size: 0.95rem;
  cursor: pointer;
  transition: all 0.08s steps(2);
  color: var(--pixel-text);
  text-decoration: none;
  display: inline-block;
  box-shadow: 4px 4px 0 var(--pixel-shadow);
  &:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--pixel-shadow);
    background: linear-gradient(180deg, rgba(120, 83, 47, 0.98), rgba(54, 36, 20, 0.98));
  }
  &:active {
    transform: translate(4px, 4px);
    box-shadow: 1px 1px 0 var(--pixel-shadow);
  }
  &--small {
    font-size: 0.85rem;
    padding: 0.35rem 0.85rem;
  }
}

.pixel-avatar-btn {
  background: none;
  border: none;
  display: flex;
  align-items: center;
  gap: 0.5rem;
  cursor: pointer;
  font-family: inherit;
  .pixel-avatar {
    font-size: 1.8rem;
  }
  .pixel-avatar-name {
    font-size: 0.9rem;
    color: var(--pixel-text);
    text-transform: uppercase;
  }
}

/* ======================
   MAIN CONTENT
   ====================== */
.pixel-main {
  max-width: 1400px;
  margin: 0 auto;
  padding: 2rem;
  min-height: calc(100vh - var(--pixel-topbar-height) - 150px);
}

/* ======================
   PIXEL FOOTER
   ====================== */
.pixel-footer {
  background: var(--pixel-bg-light);
  border-top: 4px solid var(--pixel-border);
  margin-top: 4rem;
  padding: 1.5rem;
  text-align: center;
  .pixel-footer__inner {
    max-width: 1400px;
    margin: 0 auto;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
  }
  p {
    font-size: 0.8rem;
    color: var(--pixel-text-dim);
  }
  .pixel-footer__links {
    display: flex;
    gap: 1.5rem;
    a {
      color: var(--pixel-text-dim);
      text-decoration: none;
      font-size: 0.8rem;
      &:hover {
        color: var(--pixel-primary);
      }
    }
  }
}

/* ======================
   PIXEL CARD (reusable)
   ====================== */
.pixel-card {
  border: 4px solid var(--pixel-border);
  background: linear-gradient(160deg, rgba(63, 45, 26, 0.96), rgba(45, 33, 20, 1));
  background-image: linear-gradient(160deg, rgba(255,255,255,0.02) 0%, transparent 18%),
                    linear-gradient(90deg, rgba(255,255,255,0.015) 0 1px, transparent 1px 5px);
  box-shadow: 6px 6px 0 var(--pixel-shadow);
}

/* ======================
   TYPOGRAPHY (pixel)
   ====================== */
.pixel-title {
  font-size: 3rem;
  text-transform: uppercase;
  text-shadow: 3px 3px 0 var(--pixel-primary);
  letter-spacing: 2px;
}

.pixel-heading {
  font-size: 1.8rem;
  text-align: center;
  margin: 2rem 0;
  background: linear-gradient(135deg, var(--pixel-peach), var(--pixel-secondary));
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
  display: inline-block;
  width: auto;
  padding: 0 1rem;
  text-shadow: 2px 2px 0 rgba(0, 0, 0, 0.3);
}

/* ======================
   RESPONSIVE
   ====================== */
@media (max-width: 768px) {
  .pixel-topbar__inner {
    padding: 0 1rem;
    gap: 1rem;
  }
  .pixel-nav {
    display: none; /* optional: add mobile menu later */
  }
  .pixel-logo {
    font-size: 1.2rem;
  }
  .pixel-footer__inner {
    flex-direction: column;
    text-align: center;
  }
  .pixel-main {
    padding: 1rem;
  }
  .pixel-title {
    font-size: 2rem;
  }
}

/* ========================================
   PIXEL ANIMATIONS & VISUAL EFFECTS
   ======================================== */

/* Floating pixel particles */
@keyframes floatUp {
  0% {
    transform: translateY(0) rotate(0deg);
    opacity: 1;
  }
  100% {
    transform: translateY(-100px) rotate(360deg);
    opacity: 0;
  }
}

@keyframes floatSide {
  0% {
    transform: translateX(0) translateY(0);
    opacity: 0.8;
  }
  100% {
    transform: translateX(80px) translateY(-40px);
    opacity: 0;
  }
}

.pixel-particles {
  position: relative;
  overflow: hidden;
  &::before,
  &::after {
    content: '';
    position: absolute;
    width: 8px;
    height: 8px;
    background: var(--pixel-primary);
    image-rendering: crisp-edges;
    pointer-events: none;
    z-index: 0;
  }
}

/* Hero floating character bounce */
@keyframes bouncePixel {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

.pixel-hero-character {
  animation: bouncePixel 1.5s infinite ease-in-out;
}

/* Glowing border effect on cards */
@keyframes pixelGlow {
  0% {
    border-color: var(--pixel-border);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.4);
  }
  50% {
    border-color: var(--pixel-primary);
    box-shadow: 0 0 8px var(--pixel-primary), 6px 6px 0 rgba(0,0,0,0.4);
  }
  100% {
    border-color: var(--pixel-border);
    box-shadow: 6px 6px 0 rgba(0,0,0,0.4);
  }
}

.pixel-card {
  transition: all 0.1s steps(2);
  &:hover {
    animation: pixelGlow 1.3s infinite;
    transform: translateY(-2px);
  }
}

/* Hover pixel shift for buttons */
.pixel-btn {
  transition: all 0.05s linear;
  &:active {
    transform: translate(4px, 4px);
    box-shadow: 2px 2px 0 rgba(0,0,0,0.4);
  }
}

/* Scanline overlay (retro effect) */
.scanline {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: repeating-linear-gradient(
    0deg,
    rgba(0, 0, 0, 0.05) 0px,
    rgba(0, 0, 0, 0.05) 2px,
    transparent 2px,
    transparent 6px
  );
  pointer-events: none;
  z-index: 9999;
}

/* Animated health bar (for hero stats) */
@keyframes pulseHealth {
  0% { opacity: 0.7; text-shadow: 0 0 2px #ff5f6d; }
  100% { opacity: 1; text-shadow: 0 0 6px #ff5f6d; }
}

.pixel-hero-stats span:first-child {
  animation: pulseHealth 1s infinite alternate;
}

/* Rotating pixel icon on hover */
.feature-card__icon {
  display: inline-block;
  transition: transform 0.1s steps(3);
}
.feature-card:hover .feature-card__icon {
  transform: rotate(8deg) scale(1.1);
}

/* Progress bar style (for event progress) */
.pixel-progress {
  background: #2a1a3e;
  border: 2px solid var(--pixel-border);
  height: 20px;
  width: 100%;
  margin: 1rem 0;
  position: relative;
  &__fill {
    width: 0%;
    height: 100%;
    background: repeating-linear-gradient(
      90deg,
      var(--pixel-primary),
      var(--pixel-primary) 8px,
      var(--pixel-gold) 8px,
      var(--pixel-gold) 16px
    );
    transition: width 0.3s steps(10);
  }
}

/* Floating leaderboard entry animation */
@keyframes slideIn {
  from {
    opacity: 0;
    transform: translateX(-20px);
  }
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

.leaderboard-entry {
  animation: slideIn 0.2s ease-out backwards;
  animation-delay: calc(var(--order) * 0.05s);
}

/* Parallax background (optional, subtle) */
.parallax-bg {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background-image: url('data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100" fill="%23ffcc0010"><rect width="10" height="10"/></svg>');
  background-repeat: repeat;
  opacity: 0.03;
  pointer-events: none;
  z-index: -1;
  transform: translateZ(0);
  animation: moveBackground 40s linear infinite;
}

@keyframes moveBackground {
  from { background-position: 0 0; }
  to { background-position: 100px 100px; }
}

.pixel-error-banner {
  margin: 1rem auto;
  max-width: 960px;
  padding: 0.75rem 1rem;
  background: rgba(220, 38, 38, 0.15);
  border: 1px solid #dc2626;
  border-radius: var(--border-radius-sm);
  color: #fecaca;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 1rem;
}








